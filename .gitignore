# Build output
/target
debug/

# Cargo.lock is not committed: locally the crate resolves against the Ferrite
# SDK checkout beside it, and on Ferrite the platform builds it in its own
# workspace.
Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# Debug information from MSVC Windows builds of rustc
*.pdb

# Stack traces rustc writes when it hits an internal compiler error
rustc-ice-*.txt

# Python bytecode from running scripts/
__pycache__/

# Local state written by the ferrite CLI
.ferrite/
ferrite.local.toml
